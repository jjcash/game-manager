{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window; narrow read-only application and library status/page commands",
  "windows": ["main"],
  "permissions": [
    "allow-app-get-status",
    "allow-database-get-status",
    "allow-library-get-page",
    "allow-library-get-info",
    "allow-library-get-window",
    "allow-library-query",
    "allow-manual-get",
    "allow-manual-create",
    "allow-manual-mutate",
    "allow-standalone-launch",
    "allow-backup-get-status",
    "allow-backup-create",
    "allow-backup-cancel",
    "allow-backup-select-restore",
    "allow-backup-cancel-restore",
    "allow-backup-confirm-restore",
    "allow-backup-restart",
    "allow-artwork-choose",
    "allow-artwork-clear",
    "allow-artwork-get-thumbnail",
    "allow-artwork-get-stats"
  ]
}
