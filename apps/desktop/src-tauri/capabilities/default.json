{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window; narrow read-only application and library status/page commands",
  "windows": ["main"],
  "permissions": [
    "allow-app-get-status",
    "allow-database-get-status",
    "allow-library-get-page",
    "allow-library-get-info",
    "allow-library-get-window",
    "allow-library-query"
  ]
}
